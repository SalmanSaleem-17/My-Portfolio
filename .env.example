# ── Contact form (Resend) ────────────────────────────────────────────────────
# 1. Create a free API key at https://resend.com/api-keys
# 2. Local dev: copy this file to `.env.local` and paste your key below.
# 3. Production: add RESEND_API_KEY in Vercel → Project → Settings →
#    Environment Variables (Production + Preview), then redeploy.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact-form messages are delivered.
CONTACT_TO_EMAIL=salmansaleem1771@gmail.com

# Sender address. Requires the domain to be verified in Resend. Before verifying,
# use the test sender: onboarding@resend.dev (delivers only to your account email).
CONTACT_FROM_EMAIL=Salman Saleem <contact@salmansaleem.dev>

# ── Cloudflare Turnstile (contact-form bot protection) ────────────────────────
# Create a widget at https://dash.cloudflare.com → Turnstile.
# Site key is public; Secret key is server-only. Add both in Vercel env vars too.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA_your_site_key
TURNSTILE_SECRET_KEY=0x4AAAAAAA_your_secret_key
